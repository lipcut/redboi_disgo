package templ_componets

import "github.com/disgoorg/disgolink/v3/lavalink"

script highlightCurrent(idx int) {
	return $searchIndex === idx
}

script handleClickOnResult(idx int) {
	$searchIndex = idx
	$identifier = el.dataset.identifier
	@post('/api/enqueue')
	$identifier = ''
	$searchIndex = -1
}

templ SearchResults(tracks []lavalink.Track) {
	for idx, track := range tracks {
		<li
			class="list-row py-1"
			data-search-index={ idx }
			data-identifier={ *track.Info.URI }
			data-class:bg-neutral={ highlightCurrent(idx) }
			data-on:click={ handleClickOnResult(idx) }
		>
			<div>
				<img
					class="mask mask-squircle size-6 object-cover object-center"
				 	src={ *track.Info.ArtworkURL }
				/>
			</div>
			<div class="text-sm" data-class:text-neutral-content={ highlightCurrent(idx) }>
				<div>{ track.Info.Author }</div>
				<div class="text-xs uppercase font-semibold opacity-60 truncate">
					{ track.Info.Title }
				</div>
			</div>
		</li>
	}
}
